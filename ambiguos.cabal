cabal-version:      3.4
name:               ambiguos
version:            0.1.0.0
license:            MIT
license-file:       LICENSE
author:             calafite
maintainer:         calafite@tutamail.com
category:           Development
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:  AST
                    , Automata.DFA
                    , Automata.NFA
                    , Automata.Parser
                    , Automata.Types
                    , Diagnostics
                    , Evaluation
                    , Grammar.Analysis
                    , Grammar.Specification
                    , Grammar.Types
                    , Lexer
                    , Parser
                    , Pretty
                    , Substitution
                    , TypeChecker
    build-depends:    base ^>=4.20.2.0
                    , text
                    , mtl
                    , containers
    default-language: Haskell2010

executable ambiguos
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    ambiguos
                    , base ^>=4.20.2.0
                    , text
                    , mtl
                    , containers
                    , process
                    , haskeline
                    , directory
    default-language: Haskell2010

test-suite ambiguos-test
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    build-depends:    ambiguos
                    , base ^>=4.20.2.0
                    , text
                    , containers
                    , mtl
    default-language: Haskell2010
