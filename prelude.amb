{- ==========================================================================
   Ambiguos Standard Prelude
   Calculus of Constructions with Martin-Löf Identity and Inductive Types
   ========================================================================== -}


{- --------------------------------------------------------------------------
   1. Function Combinators
   -------------------------------------------------------------------------- -}

def identity : {A : Type} -> A -> A
  = \x -> x

def id : {A : Type} -> A -> A
  = identity

def constant : {A B : Type} -> A -> B -> A
  = \x y -> x

def flip : {A B C : Type} -> (A -> B -> C) -> B -> A -> C
  = \f y x -> f x y

def compose : {A B C : Type} -> (B -> C) -> (A -> B) -> A -> C
  = \g f x -> g (f x)

def (.) : {A B C : Type} -> (B -> C) -> (A -> B) -> A -> C
  = compose

def apply : {A B : Type} -> (A -> B) -> A -> B
  = \f x -> f x

def ($) : {A B : Type} -> (A -> B) -> A -> B
  = apply


{- --------------------------------------------------------------------------
   2. Propositional Equality (Identity Types & Transport)
   -------------------------------------------------------------------------- -}

def symmetry : {A : Type} -> {x y : A} -> Id A x y -> Id A y x
  = \p -> J A x (\(z : A) -> \_ -> Id A z x) (refl A x) y p

def transitivity : {A : Type} -> {x y z : A} -> Id A x y -> Id A y z -> Id A x z
  = \p q -> J A y (\(w : A) -> \_ -> Id A x w) p z q

def congruence : {A B : Type} -> (f : A -> B) -> {x y : A} -> Id A x y -> Id B (f x) (f y)
  = \f p -> J A x (\(z : A) -> \_ -> Id B (f x) (f z)) (refl B (f x)) y p

def congruence2 : {A B C : Type} -> (f : A -> B -> C) -> {x1 x2 : A} -> {y1 y2 : B}
               -> Id A x1 x2 -> Id B y1 y2 -> Id C (f x1 y1) (f x2 y2)
  = \f p q -> J A x1 (\(z : A) -> \_ -> Id C (f x1 y1) (f z y2))
                     (congruence (f x1) q)
                     x2 p

def substitute : {A : Type} -> (P : A -> Type) -> {x y : A} -> Id A x y -> P x -> P y
  = \P p px -> J A x (\(z : A) -> \_ -> P z) px y p

def transport : {A : Type} -> (P : A -> Type) -> {x y : A} -> Id A x y -> P x -> P y
  = substitute


{- --------------------------------------------------------------------------
   3. Intuitionistic Logic & Void
   -------------------------------------------------------------------------- -}

def Not : Type -> Type
  = \A -> A -> Void

def absurd : {A : Type} -> Void -> A
  = \v -> abort A v

def doubleNegation : {A : Type} -> A -> Not (Not A)
  = \x na -> na x

def contraposition : {P Q : Type} -> (P -> Q) -> Not Q -> Not P
  = \implication notQ p -> notQ (implication p)


{- --------------------------------------------------------------------------
   4. Unit & Ordering
   -------------------------------------------------------------------------- -}

data Unit : Type where
  { unit : Unit
  }

data Ordering : Type where
  { less    : Ordering
  ; equal   : Ordering
  ; greater : Ordering
  }


{- --------------------------------------------------------------------------
   5. Booleans & Decision Procedures
   -------------------------------------------------------------------------- -}

data Bool : Type where
  { true  : Bool
  ; false : Bool
  }

def not : Bool -> Bool
  = \b -> case b of
      { true  -> false
      ; false -> true
      }

def and : Bool -> Bool -> Bool
  = \a b -> case a of
      { true  -> b
      ; false -> false
      }

def (&&) : Bool -> Bool -> Bool
  = and

def booleanAnd : Bool -> Bool -> Bool
  = and

def or : Bool -> Bool -> Bool
  = \a b -> case a of
      { true  -> true
      ; false -> b
      }

def (||) : Bool -> Bool -> Bool
  = or

def booleanOr : Bool -> Bool -> Bool
  = or

def xor : Bool -> Bool -> Bool
  = \a b -> case a of
      { true  -> not b
      ; false -> b
      }

def booleanXor : Bool -> Bool -> Bool
  = xor

def ifThenElse : {A : Type} -> Bool -> A -> A -> A
  = \b t f -> case b of
      { true  -> t
      ; false -> f
      }

def booleanEliminator : (P : Bool -> Type) -> P true -> P false -> (b : Bool) -> P b
  = \P pt pf b -> case b of
      { true  -> pt
      ; false -> pf
      }

def boolToType : Bool -> Type
  = \b -> case b of
      { true  -> Unit
      ; false -> Void
      }

def trueNotEqualFalse : Not (Id Bool true false)
  = \p -> substitute boolToType p unit

def falseNotEqualTrue : Not (Id Bool false true)
  = \p -> trueNotEqualFalse (symmetry p)


{- --------------------------------------------------------------------------
   6. Products & Dependent Pairs
   -------------------------------------------------------------------------- -}

data Pair (A B : Type) : Type where
  { pair : A -> B -> Pair A B
  }

def first : {A B : Type} -> Pair A B -> A
  = \p -> case p of
      { pair x y -> x
      }

def second : {A B : Type} -> Pair A B -> B
  = \p -> case p of
      { pair x y -> y
      }

def fst : {A B : Type} -> Pair A B -> A
  = first

def snd : {A B : Type} -> Pair A B -> B
  = second

def swap : {A B : Type} -> Pair A B -> Pair B A
  = \p -> case p of
      { pair x y -> pair y x
      }

def curry : {A B C : Type} -> (Pair A B -> C) -> A -> B -> C
  = \f a b -> f (pair a b)

def uncurry : {A B C : Type} -> (A -> B -> C) -> Pair A B -> C
  = \f p -> case p of
      { pair a b -> f a b
      }

def mapPair : {A B C D : Type} -> (A -> C) -> (B -> D) -> Pair A B -> Pair C D
  = \f g p -> case p of
      { pair x y -> pair (f x) (g y)
      }

def nonContradiction : {A : Type} -> Not (Pair A (Not A))
  = \p -> case p of
      { pair x na -> na x
      }

data Sigma (A : Type) (P : A -> Type) : Type where
  { dependentPair : (witness : A) -> P witness -> Sigma A P
  }

def proj1 : {A : Type} -> {P : A -> Type} -> Sigma A P -> A
  = \s -> case s of
      { dependentPair witness proof -> witness
      }

def proj2 : {A : Type} -> {P : A -> Type} -> (s : Sigma A P) -> P (proj1 s)
  = \s -> case s of
      { dependentPair witness proof -> proof
      }


{- --------------------------------------------------------------------------
   7. Disjoint Sums (Either) and Optionals (Maybe)
   -------------------------------------------------------------------------- -}

data Either (A B : Type) : Type where
  { left  : A -> Either A B
  ; right : B -> Either A B
  }

def either : {A B C : Type} -> (A -> C) -> (B -> C) -> Either A B -> C
  = \f g e -> case e of
      { left x  -> f x
      ; right y -> g y
      }

def isLeft : {A B : Type} -> Either A B -> Bool
  = \e -> case e of
      { left _  -> true
      ; right _ -> false
      }

def isRight : {A B : Type} -> Either A B -> Bool
  = \e -> case e of
      { left _  -> false
      ; right _ -> true
      }

def swapEither : {A B : Type} -> Either A B -> Either B A
  = \e -> case e of
      { left x  -> right x
      ; right y -> left y
      }

def mapLeft : {A B C : Type} -> (A -> C) -> Either A B -> Either C B
  = \f e -> case e of
      { left x  -> left (f x)
      ; right y -> right y
      }

def mapRight : {A B C : Type} -> (B -> C) -> Either A B -> Either A C
  = \g e -> case e of
      { left x  -> left x
      ; right y -> right (g y)
      }

data Maybe (A : Type) : Type where
  { nothing : Maybe A
  ; just    : A -> Maybe A
  }

def maybe : {A B : Type} -> B -> (A -> B) -> Maybe A -> B
  = \defaultValue f m -> case m of
      { nothing -> defaultValue
      ; just x  -> f x
      }

def fromMaybe : {A : Type} -> A -> Maybe A -> A
  = \defaultValue m -> case m of
      { nothing -> defaultValue
      ; just x  -> x
      }

def isJust : {A : Type} -> Maybe A -> Bool
  = \m -> case m of
      { nothing -> false
      ; just _  -> true
      }

def isNothing : {A : Type} -> Maybe A -> Bool
  = \m -> case m of
      { nothing -> true
      ; just _  -> false
      }

def mapMaybe : {A B : Type} -> (A -> B) -> Maybe A -> Maybe B
  = \f m -> case m of
      { nothing -> nothing
      ; just x  -> just (f x)
      }

def bindMaybe : {A B : Type} -> Maybe A -> (A -> Maybe B) -> Maybe B
  = \m f -> case m of
      { nothing -> nothing
      ; just x  -> f x
      }


{- --------------------------------------------------------------------------
   8. Peano Natural Numbers & Arithmetic Operations
   -------------------------------------------------------------------------- -}

def predecessor : Nat -> Nat
  = \n -> case n of
      { zero        -> 0
      ; successor k -> k
      }

def pred : Nat -> Nat
  = predecessor

def isZero : Nat -> Bool
  = \n -> case n of
      { zero        -> true
      ; successor _ -> false
      }

def addition : Nat -> Nat -> Nat
  = \x y -> natRec (\_ -> Nat) y (\_ -> \rec -> successor rec) x

def (+) : Nat -> Nat -> Nat
  = addition

def multiplication : Nat -> Nat -> Nat
  = \x y -> natRec (\_ -> Nat) 0 (\_ -> \rec -> y + rec) x

def (*) : Nat -> Nat -> Nat
  = multiplication

def power : Nat -> Nat -> Nat
  = \base exponent -> natRec (\_ -> Nat) 1 (\_ -> \rec -> base * rec) exponent

def (^) : Nat -> Nat -> Nat
  = power

def factorial : Nat -> Nat
  = \n -> natRec (\_ -> Nat) 1 (\(k : Nat) -> \(rec : Nat) -> (successor k) * rec) n

def subtraction : Nat -> Nat -> Nat
  = \x y -> natRec (\_ -> Nat) x (\_ -> \rec -> predecessor rec) y

def (-) : Nat -> Nat -> Nat
  = subtraction

def equalNat : Nat -> Nat -> Bool
  = \x y -> natRec (\_ -> Nat -> Bool)
                   isZero
                   (\_ -> \rec -> \n -> case n of
                       { zero        -> false
                       ; successor m -> rec m
                       })
                   x y

def (==) : Nat -> Nat -> Bool
  = equalNat

def notEqualNat : Nat -> Nat -> Bool
  = \x y -> not (equalNat x y)

def (/=) : Nat -> Nat -> Bool
  = notEqualNat

def lessOrEqualNat : Nat -> Nat -> Bool
  = \x y -> isZero (x - y)

def (<=) : Nat -> Nat -> Bool
  = lessOrEqualNat

def lessThanNat : Nat -> Nat -> Bool
  = \x y -> (successor x) <= y

def (<) : Nat -> Nat -> Bool
  = lessThanNat

def greaterOrEqualNat : Nat -> Nat -> Bool
  = \x y -> y <= x

def (>=) : Nat -> Nat -> Bool
  = greaterOrEqualNat

def greaterThanNat : Nat -> Nat -> Bool
  = \x y -> y < x

def (>) : Nat -> Nat -> Bool
  = greaterThanNat

def compareNat : Nat -> Nat -> Ordering
  = \x y -> case equalNat x y of
      { true  -> equal
      ; false -> case x < y of
          { true  -> less
          ; false -> greater
          }
      }

def min : Nat -> Nat -> Nat
  = \x y -> case x <= y of
      { true  -> x
      ; false -> y
      }

def max : Nat -> Nat -> Nat
  = \x y -> case x <= y of
      { true  -> y
      ; false -> x
      }

def even : Nat -> Bool
  = \n -> natRec (\_ -> Bool) true (\_ -> \rec -> not rec) n

def odd : Nat -> Bool
  = \n -> not (even n)


{- --------------------------------------------------------------------------
   9. Inductive Lists & Higher-Order Combinators
   -------------------------------------------------------------------------- -}

infixr 5 ++

data List (A : Type) : Type where
  { nil  : List A
  ; cons : A -> List A -> List A
  }

def foldRight : {A B : Type} -> (A -> B -> B) -> B -> List A -> B
  = \f initial xs -> case xs of
      { nil        -> initial
      ; cons x xs  -> f x (foldRight f initial xs)
      }

def foldr : {A B : Type} -> (A -> B -> B) -> B -> List A -> B
  = foldRight

def foldLeft : {A B : Type} -> (B -> A -> B) -> B -> List A -> B
  = \f initial xs -> case xs of
      { nil        -> initial
      ; cons x xs  -> foldLeft f (f initial x) xs
      }

def foldl : {A B : Type} -> (B -> A -> B) -> B -> List A -> B
  = foldLeft

def length : {A : Type} -> List A -> Nat
  = \xs -> foldRight (\_ -> \(accumulator : Nat) -> successor accumulator) 0 xs

def map : {A B : Type} -> (A -> B) -> List A -> List B
  = \f xs -> case xs of
      { nil        -> nil
      ; cons x xs  -> cons (f x) (map f xs)
      }

def append : {A : Type} -> List A -> List A -> List A
  = \xs ys -> case xs of
      { nil        -> ys
      ; cons x xs  -> cons x (append xs ys)
      }

def (++) : {A : Type} -> List A -> List A -> List A
  = append

def concat : {A : Type} -> List (List A) -> List A
  = \xss -> foldRight append nil xss

def reverse : {A : Type} -> List A -> List A
  = \xs -> foldLeft (\acc x -> cons x acc) nil xs

def filter : {A : Type} -> (A -> Bool) -> List A -> List A
  = \predicate xs -> case xs of
      { nil        -> nil
      ; cons x xs  -> case predicate x of
          { true  -> cons x (filter predicate xs)
          ; false -> filter predicate xs
          }
      }

def all : {A : Type} -> (A -> Bool) -> List A -> Bool
  = \predicate xs -> foldRight (\x acc -> (predicate x) && acc) true xs

def any : {A : Type} -> (A -> Bool) -> List A -> Bool
  = \predicate xs -> foldRight (\x acc -> (predicate x) || acc) false xs

def isNil : {A : Type} -> List A -> Bool
  = \xs -> case xs of
      { nil        -> true
      ; cons _ _   -> false
      }

def isCons : {A : Type} -> List A -> Bool
  = \xs -> not (isNil xs)

def headMaybe : {A : Type} -> List A -> Maybe A
  = \xs -> case xs of
      { nil        -> nothing
      ; cons x _   -> just x
      }

def head : {A : Type} -> A -> List A -> A
  = \defaultValue xs -> fromMaybe defaultValue (headMaybe xs)

def tail : {A : Type} -> List A -> List A
  = \xs -> case xs of
      { nil        -> nil
      ; cons _ xs  -> xs
      }

def replicate : {A : Type} -> Nat -> A -> List A
  = \count x -> natRec (\_ -> List A) nil (\_ -> \rec -> cons x rec) count

def take : {A : Type} -> Nat -> List A -> List A
  = \count xs -> case count of
      { zero        -> nil
      ; successor k -> case xs of
          { nil        -> nil
          ; cons x xs  -> cons x (take k xs)
          }
      }

def drop : {A : Type} -> Nat -> List A -> List A
  = \count xs -> case count of
      { zero        -> xs
      ; successor k -> case xs of
          { nil        -> nil
          ; cons _ xs  -> drop k xs
          }
      }

def zipWith : {A B C : Type} -> (A -> B -> C) -> List A -> List B -> List C
  = \f xs ys -> case xs of
      { nil        -> nil
      ; cons x xs  -> case ys of
          { nil        -> nil
          ; cons y ys  -> cons (f x y) (zipWith f xs ys)
          }
      }

def zip : {A B : Type} -> List A -> List B -> List (Pair A B)
  = \xs ys -> zipWith (\a b -> pair a b) xs ys
