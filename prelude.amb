-- 1. Polymorphic Identity Function
def id : (A : Type) -> (x : A) -> A
  = \(A : Type) -> \(x : A) -> x

-- 2. Propositional Equality: Symmetry
def sym : (A : Type) -> (x : A) -> (y : A) -> Id A x y -> Id A y x
  = \(A : Type) -> \(x : A) -> \(y : A) -> \p ->
      J A x (\(z : A) -> \q -> Id A z x) (refl A x) y p

-- 3. Propositional Equality: Transitivity
def trans : (A : Type) -> (x : A) -> (y : A) -> (z : A) -> Id A x y -> Id A y z -> Id A x z
  = \(A : Type) -> \(x : A) -> \(y : A) -> \(z : A) -> \p -> \q ->
      J A y (\(w : A) -> \_ -> Id A x w) p z q

-- 4. Church Booleans
def Bool : Type
  = (P : Type) -> P -> P -> P

def true : Bool
  = \(P : Type) -> \(t : P) -> \(f : P) -> t

def false : Bool
  = \(P : Type) -> \(t : P) -> \(f : P) -> f

def not : Bool -> Bool
  = \b -> \(P : Type) -> \(t : P) -> \(f : P) -> b P f t

-- 5. Logical Negation
def Not : Type -> Type
  = \(A : Type) -> A -> Void

-- 6. Theorem: true != false
-- Discriminator mapping Bool to Type: true maps to Type, false maps to Void
def boolToType : Bool -> Type
  = \b -> b Type Type Void

-- If true = false, we transport Type across the proof to obtain a value in Void
def true_neq_false : Not (Id Bool true false)
  = \p -> J Bool true (\(b : Bool) -> \_ -> boolToType b) Type false p

-- 7. Peano Arithmetic: Addition via natRec
def add : Nat -> Nat -> Nat
  = \x -> \y -> natRec (\_ -> Nat) y (\_ -> \rec -> succ rec) x

-- 8. Theorem: 0 + y = y (Holds definitionally by iota-reduction!)
def add_zero : (y : Nat) -> Id Nat (add zero y) y
  = \(y : Nat) -> refl Nat y
