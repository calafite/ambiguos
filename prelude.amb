-- Ambiguos standard prelude: pure Haskell-style syntax.

infixr 9 .
infixr 8 ^
infixl 7 * /
infixl 6 + -
infixr 5 ++ <>
infix 4 == /= < <= > >=
infixr 3 &&
infixr 2 ||
infixr 0 $

data Unit = Unit
data Bool = False | True
data Ordering = LT | EQ | GT
data Nat = Zero | Succ Nat
data Pair a b = Pair a b
data Either a b = Left a | Right b
data Maybe a = Nothing | Just a
data List a = [] | (:) a (List a)
data Dec p = Yes p | No (p -> Void)

pair x y = Pair x y
unit = Unit

type String = [Char]

identity :: a -> a
identity x = x

id :: a -> a
id x = x

const :: a -> b -> a
const x _ = x

flip :: (a -> b -> c) -> b -> a -> c
flip f y x = f x y

compose :: (b -> c) -> (a -> b) -> a -> c
compose g f x = g (f x)

(.) :: (b -> c) -> (a -> b) -> a -> c
(.) = compose

($) :: (a -> b) -> a -> b
($) f x = f x

not :: Bool -> Bool
not True = False
not False = True

otherwise = True

ifThenElse :: Bool -> a -> a -> a
ifThenElse True x _ = x
ifThenElse False _ y = y

class Eq a where { (==) :: a -> a -> Bool; (/=) :: a -> a -> Bool }

class Ord a where { compare :: a -> a -> Ordering; (<) :: a -> a -> Bool; (<=) :: a -> a -> Bool; (>) :: a -> a -> Bool; (>=) :: a -> a -> Bool }

class Add a where { (+) :: a -> a -> a }

class Sub a where { (-) :: a -> a -> a }

class Mul a where { (*) :: a -> a -> a }

class Div a where { (/) :: a -> a -> a }

class Neg a where { negate :: a -> a }

class Semigroup a where { (<>) :: a -> a -> a }

class Monoid a where { empty :: a }

class Concat a where { (++) :: a -> a -> a }

intAdd :: Int -> Int -> Int
intAdd = primIntAdd

intSub :: Int -> Int -> Int
intSub = primIntSub

intMul :: Int -> Int -> Int
intMul = primIntMul

intDiv :: Int -> Int -> Int
intDiv = primIntDiv

min :: Int -> Int -> Int
min x y = if x <= y then x else y

max :: Int -> Int -> Int
max x y = if x <= y then y else x

addition :: Nat -> Nat -> Nat
addition Zero y = y
addition (Succ x) y = Succ (addition x y)

multiplication :: Nat -> Nat -> Nat
multiplication Zero _ = Zero
multiplication (Succ x) y = addition y (multiplication x y)

natPredecessor :: Nat -> Nat
natPredecessor Zero = Zero
natPredecessor (Succ x) = x

subtraction :: Nat -> Nat -> Nat
subtraction x Zero = x
subtraction x (Succ y) = natPredecessor (subtraction x y)

data ListBox a = ListBox (List a)

foldr :: (a -> b -> b) -> b -> [a] -> b
foldr _ z [] = z
foldr f z (x : xs) = f x (foldr f z xs)

foldl :: (b -> a -> b) -> b -> [a] -> b
foldl _ z [] = z
foldl f z (x : xs) = foldl f (f z x) xs

map :: (a -> b) -> [a] -> [b]
map _ [] = []
map f (x : xs) = f x : map f xs

filter :: (a -> Bool) -> [a] -> [a]
filter _ [] = []
filter p (x : xs) = if p x then x : filter p xs else filter p xs

append :: [a] -> [a] -> [a]
append [] ys = ys
append (x : xs) ys = x : append xs ys

length :: [a] -> Int
length [] = 0
length (_ : xs) = 1 + length xs

reverseInto :: [a] -> [a] -> [a]
reverseInto [] acc = acc
reverseInto (x : xs) acc = reverseInto xs (x : acc)

reverse :: [a] -> [a]
reverse xs = reverseInto xs []

head :: [a] -> Maybe a
head [] = Nothing
head (x : _) = Just x

tail :: [a] -> Maybe [a]
tail [] = Nothing
tail (_ : xs) = Just xs

take :: Int -> [a] -> [a]
take n _ | n <= 0 = []
take _ [] = []
take n (x : xs) = x : take (n - 1) xs

drop :: Int -> [a] -> [a]
drop n xs | n <= 0 = xs
drop _ [] = []
drop n (_ : xs) = drop (n - 1) xs

takeWhile :: (a -> Bool) -> [a] -> [a]
takeWhile _ [] = []
takeWhile p (x : xs) = if p x then x : takeWhile p xs else []

dropWhile :: (a -> Bool) -> [a] -> [a]
dropWhile _ [] = []
dropWhile p (x : xs) = if p x then dropWhile p xs else x : xs

concat :: [[a]] -> [a]
concat [] = []
concat (x : xs) = append x (concat xs)

replicate :: Int -> a -> [a]
replicate n x | n <= 0 = []
replicate n x = x : replicate (n - 1) x
